local function getBestStarCar()
    if selectedCarData and selectedCarData.instanceId and tonumber(selectedCarData.instanceId) and tonumber(selectedCarData.instanceId) > 0 then
        local name = selectedCarData.rawName or selectedCarData.name
        log("[CAR] Using selected car: " .. tostring(name))
        return tonumber(selectedCarData.instanceId), name
    end
    if favCarId and favCarName then
        log("[CAR] Using fav car: " .. tostring(favCarName))
        return favCarId, favCarName
    end
    local avsCar = AVS:FindFirstChild(playerName)
    if avsCar then
        for _, child in ipairs(avsCar:GetChildren()) do
            if child:IsA("Model") then
                log("[CAR] Using current car in AVS: " .. child.Name)
                return 1, child.Name
            end
        end
    end
    log("[CAR] No car found — falling back to default")
    return 1, "2021 Auxe 4"
end

local function spawnCar(carName, instanceId)
    log("[SPAWN] name=" .. tostring(carName) .. " instanceId=" .. tostring(instanceId))
    local cash, rp
    task.spawn(function()
        local ok, v = pcall(function() return ReplicatedStorage.getCashBonus:InvokeServer(instanceId) end)
        if ok then cash = v end
    end)
    task.spawn(function()
        local ok, v = pcall(function() return ReplicatedStorage.getRPBonus:InvokeServer(instanceId) end)
        if ok then rp = v end
    end)
    local done = false
    local conn = Remotes.spawnRemoveCarFinished.OnClientEvent:Connect(function() done = true end)
    task.wait(0.05)
    Remotes.spawnRemoveCar:FireServer()
    local deadline = tick() + 12
    repeat task.wait() until (done and cash ~= nil and rp ~= nil) or tick() > deadline
    conn:Disconnect()
    if done then
        if cash and rp then
            pcall(ReplicatedStorage.updateBonusVals.FireServer, ReplicatedStorage.updateBonusVals, cash, rp)
        end
        pcall(ReplicatedStorage.SpawnCar.FireServer, ReplicatedStorage.SpawnCar, carName, instanceId)
        log("[SPAWN] Spawned: " .. tostring(carName))
    else
        log("[SPAWN] Removal timed out — spawning anyway")
        pcall(ReplicatedStorage.SpawnCar.FireServer, ReplicatedStorage.SpawnCar, carName, instanceId)
    end
    return true
end

local function getOwnedCarsFromGUI()
    local owned = {}
    pcall(function()
        local pg = player:WaitForChild("PlayerGui", 5)
        if not pg then return end
        local purchaseGui = pg:FindFirstChild("PurchaseGUI")
        if not purchaseGui then return end
        local frame1 = purchaseGui:FindFirstChild("Frame")
        if not frame1 then return end
        local frame2 = frame1:FindFirstChild("Frame")
        if not frame2 then return end
        local nameCounts = {}
        local nameIndex  = {}
        for _, btn in ipairs(frame2:GetChildren()) do
            local idVal = btn:FindFirstChild("id")
            if idVal and idVal:IsA("IntValue") and idVal.Value > 0 then
                local n = btn.Name
                nameCounts[n] = (nameCounts[n] or 0) + 1
            end
        end
        for _, btn in ipairs(frame2:GetChildren()) do
            local idVal = btn:FindFirstChild("id")
            if idVal and idVal:IsA("IntValue") and idVal.Value > 0 then
                local n    = btn.Name
                local id   = idVal.Value
                local carNameChild = btn:FindFirstChild("CarName")
                local displayName  = n
                if carNameChild then
                    local txt = carNameChild:IsA("TextLabel") and carNameChild.Text
                              or carNameChild:IsA("StringValue") and carNameChild.Value or nil
                    if txt and txt ~= "" then displayName = txt end
                end
                if displayName == n and nameCounts[n] and nameCounts[n] > 1 then
                    nameIndex[n] = (nameIndex[n] or 0) + 1
                    displayName  = n .. " #" .. nameIndex[n]
                end
                table.insert(owned, { name = displayName, rawName = n, instanceId = id })
                log("[CAR] Found: " .. displayName .. " id=" .. tostring(id))
            end
        end
        log("[CAR] Total owned: " .. tostring(#owned))
    end)
    return owned
end

local function waitForCar()
    local car = nil
    local deadline = tick() + 18
    repeat car = AVS:FindFirstChild(playerName); task.wait(0.3) until car or tick() > deadline
    if not car then return nil, nil end
    local seat = car:FindFirstChild("DriveSeat", true) or car:FindFirstChildWhichIsA("VehicleSeat", true)
    if not seat then
        task.wait(1.5)
        seat = car:FindFirstChild("DriveSeat", true) or car:FindFirstChildWhichIsA("VehicleSeat", true)
    end
    return car, seat
end

local function enterCar(seat)
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp  = char:WaitForChild("HumanoidRootPart")
    hrp.CFrame = seat.CFrame * CFrame.new(0, 0, 2)
    task.wait(0.3)
    local prompt = seat:FindFirstChild("ProximityPrompt") or seat:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        if hasFPP then
            pcall(fireproximityprompt, prompt)
            task.wait(0.5)
            local c = player.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h and h.SeatPart then return end
        else
            pcall(function()
                prompt.MaxActivationDistance = 9999; prompt.Enabled = true
                prompt:InputHoldBegin(); task.wait((prompt.HoldDuration or 0) + 0.1); prompt:InputHoldEnd()
            end)
            task.wait(0.5)
            local c = player.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h and h.SeatPart then return end
        end
    end
    local c = player.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then pcall(seat.Sit, seat, h) end
    task.wait(0.5)
end

local function clickSwerveButton()
