local connections = {}
local function add(conn)
    table.insert(connections, conn)
    return conn
end

_G.ZinXCleanup = function()
    for _, c in connections do
        if c.Connected then c:Disconnect() end
    end
    table.clear(connections)
    
    -- Stop all feature connections
    if _G.ZinNoclipConn then _G.ZinNoclipConn:Disconnect(); _G.ZinNoclipConn = nil; _G.ZinNoclipEnabled = false end
    if _G.ZinInfJumpConn then _G.ZinInfJumpConn:Disconnect(); _G.ZinInfJumpConn = nil; _G.ZinInfJumpEnabled = false end
    if _G.ZinLoopSpeedConn then _G.ZinLoopSpeedConn:Disconnect(); _G.ZinLoopSpeedConn = nil; _G.ZinLoopSpeedEnabled = false end
    if _G.ZinCarSpeedConn then _G.ZinCarSpeedConn:Disconnect(); _G.ZinCarSpeedConn = nil; _G.ZinCarSpeedEnabled = false end
    if _G.ZinTPToolConn then _G.ZinTPToolConn:Disconnect(); _G.ZinTPToolConn = nil; _G.ZinTPToolActive = false end
    
    -- Restore collisions
    local char = player.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and _G.ZinOriginalCollisions and _G.ZinOriginalCollisions[part] ~= nil then
                part.CanCollide = _G.ZinOriginalCollisions[part]
            end
        end
    end
    
    for _, g in CoreGui:GetChildren() do
        if g.Name == "ZinXToggle" or g.Name == "ZinXNotif" or g.Name == "ZinXLogGui"
        or g.Name == "ZinXCarPicker" or g.Name == "ZinXTimePicker" or g.Name == "ZinXBlackout"
        or g.Name == "ZinTPToolGui" then g:Destroy() end
    end
    local pg = player:FindFirstChild("PlayerGui")
    if pg then
        for _, g in pg:GetChildren() do
            if g.Name == "ZinXToggle" or g.Name == "ZinXNotif" or g.Name == "ZinXLogGui"
            or g.Name == "ZinXCarPicker" or g.Name == "ZinXTimePicker" or g.Name == "ZinXBlackout"
            or g.Name == "ZinTPToolGui" then g:Destroy() end
        end
    end
end

