local function addCrateSection(tab, title, remote)
    tab:Section({ Title = title })
    local qty = tab:Input({ Title = "Quantity", Placeholder = "Enter amount...", Callback = function() end })
    local busy = false
    tab:Button({ Title = "Purchase Crates", Callback = function()
        if busy then log("Already buying!"); return end
        task.spawn(function()
            local n = tonumber(qty.Value or "")
            if not n or n < 1 then log("Invalid quantity"); return end
            busy = true; log("Buying " .. n .. " " .. title ...)
            for _ = 1, n do
                local ok, r = pcall(function() return remote:InvokeServer(table.unpack(CRATE_ARGS)) end)
                log(ok and parseResult(r) or "Failed"); task.wait(CRATE_DELAY)
            end
            log(title .. " complete!"); busy = false
        end)
    end })
end
