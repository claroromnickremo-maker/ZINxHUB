local function httpGet(url)
    local ok, r = pcall(function() return game:HttpGet(url) end)
    if ok and type(r) == "string" and #r > 100 then return r end
    local req = (typeof(request) == "function" and request)
             or (typeof(http_request) == "function" and http_request)
    if req then
        ok, r = pcall(function()
            local resp = req({ Url = url, Method = "GET" })
            return resp and (resp.Body or resp.body) or ""
        end)
        if ok and type(r) == "string" and #r > 100 then return r end
    end
    ok, r = pcall(function() return HttpService:GetAsync(url) end)
    if ok and type(r) == "string" and #r > 100 then return r end
    return nil
end

