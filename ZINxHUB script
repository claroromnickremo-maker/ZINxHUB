local function ejectFromCar()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then return end
    pcall(function()
        local VehicleController = require(game:GetService("Players").LocalPlayer.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
    end)
    pcall(function()
        local ContextActionService = game:GetService("ContextActionService")
        ContextActionService:CallFunction("leaveVehicleAction", Enum.UserInputState.Begin, nil)
    end)
    task.wait(0.2)
    if hum.SeatPart then
        pcall(function() hum.Jump = true end)
        task.wait(0.2)
    end
end

local function parseResult(data)
    local p = (type(data) == "table" and data[1]) and data[1] or data
    if type(p) == "table" then
        local n = p.Item or p.Vehicle or p.Car or p.Part or p.Name
        local r = p.Rarity or p.Type
        if n then return tostring(n) .. (r and (" [" .. tostring(r) .. "]") or "") end
        return HttpService:JSONEncode(p)
    end
    return tostring(p)
end

local function disableParts(model)
    for _, v in model:GetDescendants() do
        if v:IsA("BasePart") and not v.Anchored then
            v.CanTouch = false; v.CanCollide = false
        end
    end
end

local function enableParts(model)
    for _, v in model:GetDescendants() do
        if v:IsA("BasePart") and not v.Anchored then
            v.CanTouch = true; v.CanCollide = true
        end
    end
end

local function disableOtherCollisions(ownCar)
    local traffic = workspace:FindFirstChild("AITraffic") and workspace.AITraffic:FindFirstChild("Car")
    if traffic then
        for _, npc in traffic:GetChildren() do
            if npc:IsA("Model") and npc.Name:match("AICar") then pcall(disableParts, npc) end
        end
    end
    pcall(function()
        for _, folder in AVS:GetChildren() do
            if folder.Name ~= playerName then
                for _, v in folder:GetDescendants() do
                    if v:IsA("BasePart") and not v.Anchored then
                        v.CanTouch = false; v.CanCollide = false
                    end
                end
            else
                for _, v in folder:GetDescendants() do
                    if v:IsA("BasePart") and not v.Anchored then
                        local isOwnCar = ownCar and v:IsDescendantOf(ownCar)
                        if not isOwnCar then v.CanTouch = false; v.CanCollide = false end
                    end
                end
            end
        end
    end)
end

