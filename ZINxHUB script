startFarm = function()
    if farmBusy then log("Already starting..."); return end
    farmBusy = true; farmEnabled = true
    log("Starting autofarm...")

    log("[1/6] Teleporting to Swerve...")
    pcall(function() Remotes.TeleportRequest:FireServer("Swerve") end)
    task.wait(5)
    if not farmEnabled then log("Cancelled."); farmBusy = false; return end

    local char = player.Character or player.CharacterAdded:Wait()
    local hrp  = char:WaitForChild("HumanoidRootPart")
    log("[2/6] Waiting for map...")
    waitForGround(hrp)
    task.wait(0.5)
    if not farmEnabled then log("Cancelled."); farmBusy = false; return end

    log("[3/6] Spawning car...")
    local id, name = getBestStarCar()
    log("Spawning: " .. tostring(name))
    if not spawnCar(name, id) then retryFarm("Spawn failed"); return end
    task.wait(2.5)
    if not farmEnabled then log("Cancelled."); farmBusy = false; return end

    log("[4/6] Finding car...")
    currentCar, currentSeat = waitForCar()
    if not currentCar or not currentSeat then retryFarm("Car not found"); return end

    log("[5/6] Getting in car...")
    char = player.Character or player.CharacterAdded:Wait()
    for attempt = 1, 3 do
        if not farmEnabled then log("Cancelled."); farmBusy = false; return end
        enterCar(currentSeat)
        task.wait(0.5)
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hum and hum.SeatPart then log("Seated!"); break end
        if attempt < 3 then log("Retry sit " .. (attempt + 1) .. "/3..."); task.wait(0.5)
        else log("WARNING: Could not confirm seating, continuing anyway...") end
    end
    if not farmEnabled then log("Cancelled."); farmBusy = false; return end

    log("[6/6a] Starting swerve run...")
    for _ = 1, 5 do
        local ok, result = pcall(clickSwerveButton)
        if ok and result then break end
        task.wait(0.5)
    end
    task.wait(1)
    if not farmEnabled then log("Cancelled."); farmBusy = false; return end

    log("[6/6] Autofarm running!")
    farming = true; _G.ZinFarming = true

    local blackoutGui = createBlackout("ZIN X HUB  |  FARMING", GOAL_RACE_TIME, true)

    local aiLockConn = nil
    _G.ZinAiLockStop = function()
        if aiLockConn then aiLockConn:Disconnect(); aiLockConn = nil end
        log("[AI] Cars released")
    end
    task.spawn(function()
        local carFolder = workspace:FindFirstChild("AITraffic") and workspace.AITraffic:FindFirstChild("Car")
        if not carFolder then return end
        aiLockConn = RunService.Heartbeat:Connect(function()
            if not farming then return end
            local char = player.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local pos     = hrp.Position
            local lookDir = hrp.CFrame.LookVector
            local behind  = CFrame.new(
                pos.X - lookDir.X * 120,
                pos.Y,
                pos.Z - lookDir.Z * 120
            )
            for _, car in ipairs(carFolder:GetChildren()) do
                pcall(function()
                    for _, part in ipairs(car:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.AssemblyLinearVelocity  = Vector3.zero
                            part.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                    car:PivotTo(behind)
                end)
            end
        end)
        log("[AI] Cars locked 120 studs behind")
    end)
    farmSpeed = FARM_MAX; farmRetries = 0; resetTriggered = false

    local groundRayParams = RaycastParams.new()
    groundRayParams.FilterDescendantsInstances = { currentCar }
    groundRayParams.FilterType = Enum.RaycastFilterType.Exclude

    local seatLostFrames = 0

    task.wait(0.2)
    local laneX = currentSeat.Position.X
    local laneY = currentSeat.Position.Y
    local laneZ = currentSeat.Position.Z
    _G.ZinMilesStarted = false
    local fixedForward  = Vector3.new(currentSeat.CFrame.LookVector.X, 0, currentSeat.CFrame.LookVector.Z).Unit
    local fixedRight    = Vector3.new(currentSeat.CFrame.RightVector.X, 0, currentSeat.CFrame.RightVector.Z).Unit
    local lockedLateral = fixedRight:Dot(currentSeat.Position)
    _G.ZinFixedForward  = fixedForward
    _G.ZinFixedRight    = fixedRight
    _G.ZinLateralDodge  = 0
    log("[FARM] fwd=" .. tostring(fixedForward) .. " lane=" .. string.format("%.1f", lockedLateral))

    local spawnGhostCars = function()
        local spawn   = _G.ZinGhostSpawn
        local despawn = _G.ZinGhostDespawn
        if not spawn then return false end
        if despawn then
            local aiTraffic = workspace:FindFirstChild("AITraffic") and workspace.AITraffic:FindFirstChild("Car")
            if aiTraffic then
                for _, car in ipairs(aiTraffic:GetChildren()) do
                    if car:IsA("Model") and car.Name:match("AICar") then
                        pcall(function()
                            local guid = car:FindFirstChild("GUID") or car:GetAttribute("GUID")
                            if guid then despawn:FireServer(tostring(guid)) end
                        end)
                    end
                end
            end
        end
        task.wait(0.1)
        local speed = FARM_MAX
        for i = 1, 6 do
            pcall(function()
                local guid = HttpService:GenerateGUID(false)
                spawn:FireServer(guid, "Lane1", speed)
            end)
            task.wait(0.05)
        end
        log("[FARM] Ghost cars spawned via server remote")
        return true
    end

    if not spawnGhostCars() then
        local aiCarFolder = workspace:FindFirstChild("AITraffic") and workspace.AITraffic:FindFirstChild("Car")
        if aiCarFolder then
            for _, car in ipairs(aiCarFolder:GetChildren()) do
                if not car:IsA("Model") or not car.Name:match("AICar") then continue end
                pcall(function()
                    local myPos = currentSeat.Position
                    car:PivotTo(CFrame.new(myPos.X, myPos.Y, myPos.Z - 25))
                end)
            end
        end
    end

    farmSpeed = FARM_MAX
    _G.ZinFakeDist = 0

    local Remotes2 = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    local notifyRemote = Remotes2 and Remotes2:FindFirstChild("notifyEvent")
    if notifyRemote then
        addFarm(notifyRemote.OnClientEvent:Connect(function(msg)
            if type(msg) == "string" and msg:lower():find("daily") then
                log("[FARM] Daily limit reached — stopping farm")
                farming = false; _G.ZinFarming = false
                farmEnabled = false
                if farmConn then farmConn:Disconnect(); farmConn = nil end
            end
        end))
    end

    task.spawn(function()
        while farming and farmEnabled do
            task.wait(2)
            if not farming then break end

            pcall(function()
                local carFolder = AVS:FindFirstChild(playerName)
                local milesVal = carFolder and carFolder:FindFirstChild("Miles")
                if milesVal and milesVal.Value > 0 and not _G.ZinMilesStarted then
                    _G.ZinMilesStarted = true
                    local pos = currentSeat and currentSeat.Position
                    if pos then log(string.format("[MILES] Started! Z=%.0f dist=%.0f", pos.Z, math.abs(pos.Z - laneZ))) end
                end
            end)

            if autoReset and not resetTriggered then
                local carFolder = AVS:FindFirstChild(playerName)
                local score = carFolder and carFolder:FindFirstChild("Score")
                if score and score.Value >= RESET_SCORE then
                    resetTriggered = true
                    log("Reset score reached — resetting...")
                    farming = false; _G.ZinFarming = false
                    if farmConn then farmConn:Disconnect(); farmConn = nil end
                    task.spawn(resetPlayer)
                    return
                end
            end
        end
    end)

    task.spawn(function()
        while farming and farmEnabled do
            task.wait(1)
            pcall(clickSwerveButton)
        end
    end)

    farmConn = RunService.Heartbeat:Connect(function(dt)
        if not farming or not farmEnabled then return end
        if not currentSeat or not currentSeat.Parent then
            seatLostFrames = seatLostFrames + 1
            if seatLostFrames < 10 then return end
            farming = false; _G.ZinFarming = false
            farmConn:Disconnect(); farmConn = nil
            retryFarm("Seat lost")
            return
        end
        seatLostFrames = 0
        _G.ZinLastCarPos = currentSeat.Position

        pcall(function()
            local driftX = currentSeat.Position.X - laneX
            local corrX  = math.clamp(-driftX * 60, -80, 80)
            currentSeat.AssemblyLinearVelocity  = Vector3.new(corrX, 0, fixedForward.Z * farmSpeed)
            currentSeat.AssemblyAngularVelocity = Vector3.zero
            currentSeat.Throttle   = 1
            currentSeat.SteerFloat = 0
        end)
    end)
end

resetPlayer = function()
    farming = false; _G.ZinFarming = false
    farmBusy = false; farmSpeed = 0; farmRetries = 0
    cleanFarmConns()
    if farmConn then farmConn:Disconnect(); farmConn = nil end
    pcall(function()
        if currentSeat and currentSeat.Parent then
