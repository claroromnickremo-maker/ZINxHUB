    pcall(function() down = UserInputService:IsKeyDown(Enum.KeyCode.RightShift) end)
    if down and not keyWasDown then doToggle() end
    keyWasDown = down
end))

local function protectGuis()
    pcall(function()
        for _, g in CoreGui:GetChildren() do
            if g:IsA("ScreenGui") and (g.Name:find("WindUI") or g.Name:find("ZinX")) then
                g.ResetOnSpawn = false
                if g.Name ~= "ZinXBlackout" then pcall(function() g.DisplayOrder = 99999 end) end
            end
        end
    end)
    local pg = player:FindFirstChild("PlayerGui")
    if pg then
        for _, g in pg:GetChildren() do
            if g:IsA("ScreenGui") and (g.Name:find("WindUI") or g.Name:find("ZinX")) and g.Name ~= "ZinXLogGui" then
                g.ResetOnSpawn = false
                if g.Name ~= "ZinXBlackout" then
                    pcall(function() g.Parent = CoreGui end)
                    pcall(function() g.DisplayOrder = 99999 end)
                end
            end
        end
    end
end
