local function retryFarm(reason)
    if not farmEnabled then return end
    cleanFarmConns()
    if farmConn then farmConn:Disconnect(); farmConn = nil end
    farmRetries = farmRetries + 1
    if farmRetries > FARM_MAX_RETRIES then
        log("Max retries reached. Stopping.")
        farmBusy = false; farmEnabled = false; farmRetries = 0
        return
    end
    log(reason .. " — retry " .. farmRetries .. "/" .. FARM_MAX_RETRIES .. " in 3s...")
    task.delay(3, function()
        if farmEnabled and farmBusy then farmBusy = false; startFarm() end
    end)
end

