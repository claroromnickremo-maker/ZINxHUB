local menuVisible = true
local function doToggle()
    menuVisible = not menuVisible
    if menuVisible then if logGui then pcall(function() logGui.Enabled = true end) end end
    if not pcall(function() Window:Toggle() end) then
        if not pcall(function() Window:SetVisibility(menuVisible) end) then
            if not pcall(function() Window.Enabled = menuVisible end) then
                pcall(function()
                    for _, g in CoreGui:GetChildren() do
                        if g:IsA("ScreenGui") and (g.Name:find("WindUI") or g.Name:find("ZinX")) then g.Enabled = menuVisible end
                    end
                    local pg = player:FindFirstChild("PlayerGui")
                    if pg then
                        for _, g in pg:GetChildren() do
                            if g:IsA("ScreenGui") and (g.Name:find("WindUI") or g.Name:find("ZinX")) then g.Enabled = menuVisible end
                        end
                    end
                end)
            end
        end
    end
    if not menuVisible then
        task.delay(0.3, function() if not menuVisible and logGui then pcall(function() logGui.Enabled = false end) end end)
    end
end

local keyWasDown = false
add(RunService.Heartbeat:Connect(function()
