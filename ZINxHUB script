local function parseCountdown(text)
    if not text then return 0 end
    local num = text:match("%d+")
    return tonumber(num) or 0
end

local function fireRobberyPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    local originalHold = prompt.HoldDuration
    prompt.HoldDuration = 0
    if hasFPP then
        pcall(fireproximityprompt, prompt, 0)
    else
        pcall(function() prompt:InputHoldBegin(); prompt:InputHoldEnd() end)
    end
    prompt.HoldDuration = originalHold
end

local function doRobberyAuto(robberyName, onStatusUpdate)
    if not robberyRunning then return end
    local config = robberies[robberyName]
    if not config then log("[ROBBERY] Unknown: " .. tostring(robberyName)); return end
    onStatusUpdate("Starting " .. robberyName ...)

    currentDropoffPos = nil

    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")

    onStatusUpdate("Teleporting to " .. robberyName ...)
    hrp.CFrame = CFrame.new(config.teleport)
    task.wait(1)
    if not robberyRunning then return end

    onStatusUpdate("Checking player state...")
    local hum0 = char:FindFirstChildOfClass("Humanoid")
    if hum0 and hum0.SeatPart then
        ejectFromCar()
        task.wait(0.5)
    end
    local unseatDeadline = tick() + 5
    repeat
        task.wait(0.1)
        char = player.Character or player.CharacterAdded:Wait()
        hum0 = char:FindFirstChildOfClass("Humanoid")
    until (hum0 and not hum0.SeatPart) or tick() > unseatDeadline
    task.wait(0.3)

    local robberyFolder = workspace:FindFirstChild("Robbery") and workspace.Robbery:FindFirstChild(robberyName)
    if not robberyFolder then onStatusUpdate("ERROR: Robbery not found"); return end
    local prompt = robberyFolder:FindFirstChild("ProximityPrompt")
    if not prompt then
        for _, d in ipairs(robberyFolder:GetDescendants()) do
            if d:IsA("ProximityPrompt") then prompt = d; break end
        end
    end
    if prompt then
        onStatusUpdate("Moving to prompt...")
        if prompt.Parent and prompt.Parent:IsA("BasePart") then
            hrp.CFrame = prompt.Parent.CFrame * CFrame.new(0, 0, 2)
            task.wait(0.5)
        end
        prompt.MaxActivationDistance = 9999
        onStatusUpdate("Waiting for robbery to be ready...")
        local promptReady = tick() + 30
        repeat
            task.wait(1)
            if not robberyRunning then return end
        until (not prompt.Enabled == false) or tick() > promptReady
        task.wait(0.5)
        onStatusUpdate("Firing robbery prompt...")
        fireRobberyPrompt(prompt)
        task.wait(0.5)
    else onStatusUpdate("ERROR: No prompt found"); return end

    onStatusUpdate("Reading countdown...")
    local waitTime = 0
    local startTime = tick()
    while tick() - startTime < 60 do
        if not robberyRunning then return end
        local remaining = parseCountdown(getCountdownText(robberyName))
        if remaining and remaining > 0 then
            onStatusUpdate("Countdown: " .. tostring(remaining) .. "s")
            waitTime = remaining; break
        end
        task.wait(0.5)
    end
    if waitTime > 0 then
        onStatusUpdate("Waiting " .. tostring(waitTime) .. "s...")
        task.wait(waitTime + 1)
    else
        onStatusUpdate("Using default 30s..."); task.wait(30)
    end
    if not robberyRunning then return end

    onStatusUpdate("Waiting for dropoff...")
    local dropoffWaitStart = tick()
    while not currentDropoffPos and tick() - dropoffWaitStart < 10 do
        task.wait(0.5)
        if not robberyRunning then return end
    end
    if not currentDropoffPos then onStatusUpdate("ERROR: No dropoff assigned"); return end
    local returnPos = currentDropoffPos

    onStatusUpdate("Spawning car...")
    local id, name = getBestStarCar()
    spawnCar(name, id)
    task.wait(2.5)
    local robCar, robSeat = waitForCar()
    if not robCar or not robSeat then
        onStatusUpdate("ERROR: Car not found after spawn"); return
    end
    enterCar(robSeat)
    task.wait(1)
    if not robberyRunning then return end

    onStatusUpdate("Floating car to dealer...")
    local noclipParts = {}
    for _, v in ipairs(robCar:GetDescendants()) do
        if v:IsA("BasePart") then
            pcall(function() v.CanCollide = false end)
            table.insert(noclipParts, v)
        end
    end
    local floatConn = RunService.Heartbeat:Connect(function()
        local seat = getRaceSeat(robCar)
        if not seat then return end
        local toTarget = Vector3.new(returnPos.X, returnPos.Y + 8, returnPos.Z) - seat.Position
        if toTarget.Magnitude < 1 then return end
        pcall(function()
            seat.AssemblyLinearVelocity  = toTarget.Unit * 276
            seat.AssemblyAngularVelocity = Vector3.zero
        end)
    end)
    local floatTimeout = tick() + 60
    repeat
        task.wait()
        local seat = getRaceSeat(robCar)
        if seat and (Vector3.new(seat.Position.X, 0, seat.Position.Z) - Vector3.new(returnPos.X, 0, returnPos.Z)).Magnitude < 15 then break end
    until tick() > floatTimeout
    floatConn:Disconnect()
    for _, v in ipairs(noclipParts) do pcall(function() v.CanCollide = true end) end
    task.wait(0.3)

    onStatusUpdate("FIRING DEALER PROMPT!")
    ejectFromCar()
    local unseatDeadline = tick() + 5
    repeat
        task.wait(0.1)
        char = player.Character or player.CharacterAdded:Wait()
        local hum2 = char:FindFirstChildOfClass("Humanoid")
        if hum2 and not hum2.SeatPart then break end
    until tick() > unseatDeadline
    hrp = char:WaitForChild("HumanoidRootPart")
    task.wait(0.5)

    local dropoffPrompt = nil
    local closestDist = math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent:IsA("BasePart") then
            local dist = (obj.Parent.Position - returnPos).Magnitude
            if dist < 50 and dist < closestDist then
                closestDist = dist
                dropoffPrompt = obj
            end
        end
    end

    if dropoffPrompt then
        dropoffPrompt.MaxActivationDistance = 9999
        task.wait(0.3)
        fireRobberyPrompt(dropoffPrompt)
        task.wait(0.5)
        onStatusUpdate(robberyName:upper() .. " COMPLETE!")
    else
        onStatusUpdate("ERROR: No dealer prompt!")
    end
    onStatusUpdate("Done!")
end

