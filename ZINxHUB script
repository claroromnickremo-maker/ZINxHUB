local function getRaceSeat(car)
    local char = player.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart then return hum.SeatPart end
    local best = car:FindFirstChild("DriveSeat", true)
    if not best then
        for _, v in pairs(car:GetDescendants()) do
            if v:IsA("VehicleSeat") then
                local n = v.Name:lower()
                if n:find("drive") or n:find("driver") or n:find("front") then best = v; break end
            end
        end
    end
    if not best then best = car:FindFirstChildWhichIsA("VehicleSeat", true) end
    return best
end

local function stopRaceCar(car)
    local seat = getRaceSeat(car)
    if seat then
        pcall(function()
            seat.Throttle = 0; seat.SteerFloat = 0
            seat.AssemblyLinearVelocity = Vector3.zero
            seat.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

local function teleportCarTo(car, cf)
    if typeof(cf) == "Vector3" then cf = CFrame.new(cf) end
    local anyPart = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart", true)
    if not anyPart then return end
    local anchoredParts = {}
    for _, v in pairs(car:GetDescendants()) do
        if v:IsA("BasePart") then
            pcall(function()
                v.AssemblyLinearVelocity = Vector3.zero
                v.AssemblyAngularVelocity = Vector3.zero
                if not v.Anchored then v.Anchored = true; table.insert(anchoredParts, v) end
            end)
        end
    end
    task.wait(0.05)
    local ok = pcall(function() car:PivotTo(cf) end)
    if not ok then
        local delta = cf * anyPart.CFrame:Inverse()
        for _, v in pairs(car:GetDescendants()) do
            if v:IsA("BasePart") then pcall(function() v.CFrame = delta * v.CFrame end) end
        end
    end
    task.wait(0.1)
    for _, v in ipairs(anchoredParts) do pcall(function() v.Anchored = false end) end
    task.wait(0.2)
end

