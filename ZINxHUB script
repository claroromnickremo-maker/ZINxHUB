local function waitForGround(hrp)
    for _ = 1, 30 do
        task.wait(0.5)
        local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -50, 0), RaycastParams.new())
        if ray then
            hrp.CFrame = CFrame.new(hrp.Position.X, ray.Position.Y + 5, hrp.Position.Z)
                * (hrp.CFrame - hrp.CFrame.Position)
            return true
        end
    end
    task.wait(3)
    return false
end

