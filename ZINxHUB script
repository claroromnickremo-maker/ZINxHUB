local function enableNoclip()
    local char = player.Character
    if not char then return end
    _G.ZinOriginalCollisions = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            _G.ZinOriginalCollisions[part] = part.CanCollide
            part.CanCollide = false
        end
    end
    _G.ZinNoclipConn = RunService.Stepped:Connect(function()
        if not _G.ZinNoclipEnabled then return end
        local char = player.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
    log("[MISC] Noclip enabled")
end

local function disableNoclip()
    if _G.ZinNoclipConn then
        _G.ZinNoclipConn:Disconnect()
        _G.ZinNoclipConn = nil
    end
    local char = player.Character
    if char then
        for part, canCollide in pairs(_G.ZinOriginalCollisions) do
            if part and part.Parent then
                part.CanCollide = canCollide
            end
        end
    end
    _G.ZinOriginalCollisions = {}
    _G.ZinNoclipEnabled = false
    log("[MISC] Noclip disabled")
end

