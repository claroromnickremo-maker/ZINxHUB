local function getCountdownText(robberyName)
    local robbery = workspace:FindFirstChild("Robbery") and workspace.Robbery:FindFirstChild(robberyName)
    if not robbery then return nil end
    local parts = robberies[robberyName].countdownPath:split(".")
    local current = robbery
